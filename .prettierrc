{
  "printWidth": 110,
  "tabWidth": 2,
  "singleQuote": false,
  "semi": true,
  "trailingComma": "es5",
  "plugins": ["prettier-plugin-jinja-template", "prettier-plugin-tailwindcss"],
  "overrides": [
    {
      "files": ["*.html"],
      "options": {
        "parser": "jinja-template"
      }
    }
  ]
}
